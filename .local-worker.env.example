# Copy this file to .local-worker.env on the trusted Worker host, then replace
# placeholders locally.  .local-worker.env is intentionally gitignored.
# setup_teacher_worker.ps1 can create this file from the template, but it never
# fills, prints, resets, or uploads secret values.

TEACHER_BASE_URL=https://teacher.example.invalid
MATERIAL_WORKER_TOKEN=REPLACE_WITH_RENDER_WORKER_TOKEN
# Stable host identity for heartbeat/observability. Keep the same value across
# process restarts and upgrades on this physical Worker computer.
MATERIAL_WORKER_ID=lab-worker-01

# Local Worker reliability/runtime settings.
# 2s keeps the queue responsive without adding unsafe job concurrency.
MATERIAL_WORKER_POLL_SECONDS=2
MATERIAL_WORKER_HEARTBEAT_SECONDS=30
# Phase 2 performance. "auto" probes QSV -> NVENC -> AMF with a real 1-frame
# encode; if none works, the same job falls back to libx264 automatically.
MATERIAL_VIDEO_HARDWARE_ACCELERATION=true
MATERIAL_VIDEO_HARDWARE_ENCODER=auto
# Keep one headless LibreOffice instance warm between Office jobs. Failures
# restart once, then fall back to an isolated one-shot soffice conversion.
# Prefer installed desktop Microsoft PowerPoint for PPT/PPTX preview fidelity.
# If COM is unavailable/disabled/times out, Worker falls back to LibreOffice.
MATERIAL_POWERPOINT_COM_PREVIEW_ENABLED=true
MATERIAL_POWERPOINT_COM_TIMEOUT_SECONDS=60
# Direct PowerPoint slide export keeps the deck aspect ratio; this sets only
# the longer output edge. 1920 is sharp enough for teaching without huge files.
MATERIAL_POWERPOINT_PREVIEW_LONG_EDGE=1920
MATERIAL_LIBREOFFICE_WARM_ENABLED=true
MATERIAL_LIBREOFFICE_WARM_STARTUP_SECONDS=5
# Persistent LibreOffice profile (font cache etc.) so a Worker restart does not
# pay the cold start again. Blank = LOCALAPPDATA\Teacher\libreoffice-profile.
MATERIAL_LIBREOFFICE_PROFILE_DIR=
# How often (minutes) the Worker compares its code version with the website
# and reports the result in its heartbeat / startup log.
WORKER_SITE_VERSION_CHECK_MINUTES=30
# Slide image rendering: WebP encoder effort 0-6 (4 is fast and visually the
# same as 6) and render DPI (100-220).
MATERIAL_WEBP_METHOD=4
MATERIAL_SLIDE_DPI=170
MATERIAL_WORKER_AUTO_UPDATE=false
MATERIAL_WORKER_UPDATE_INTERVAL_MINUTES=15
MATERIAL_WORKER_RELEASE_REF=v6.8.1
MATERIAL_WORKER_RELEASE_COMMIT=
MATERIAL_WORKER_REQUIRE_SIGNED_TAG=true

# Dedicated AI Worker. The hospital PC uses Render Web as its HTTPS 443
# control plane; it does NOT need direct PostgreSQL 5432/6543 access.
# Production hospital Worker uses HTTPS 443 only. Legacy direct PostgreSQL is
# available only when explicitly set to "database" for controlled development.
AI_WORKER_TRANSPORT=https
# Optional dedicated token. Leave blank to reuse MATERIAL_WORKER_TOKEN during
# migration; for production isolation set the same AI_WORKER_TOKEN in Render.
AI_WORKER_TOKEN=
AI_WORKER_HTTP_TIMEOUT_SECONDS=20
AI_WORKER_HTTP_ATTEMPTS=3
AI_WORKER_JOB_HEARTBEAT_SECONDS=30
# Legacy/direct-DB fallback only. It is ignored when HTTPS transport is active.
DATABASE_URL=
FREE_ONLY_MODE=true
AI_EXTERNAL_PROCESSING_ENABLED=true
AI_DEIDENTIFICATION_ENABLED=true
# Keep raw image/audio/video off cloud AI by default. When false, AI subtitles
# use local faster-whisper instead of sending media to Groq transcription.
AI_EXTERNAL_MEDIA_ALLOWED=false
# groq / gemini = 固定先用該家；auto = 依教材自動選：
# 圖片、影音、影片互動題 → 先用 Gemini；一般文字教材 → 先用 Groq（一次出 6 題以上會自動分批）。
# 失敗時都會自動換下一家（Gemini ↔ Groq，最後才是本機 AI）。
AI_PROVIDER=groq
AI_FREE_FALLBACK_ENABLED=true
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Optional second free cloud provider. When Groq returns quota/rate-limit or a
# transient unavailable error, the Worker may retry with Gemini. Validation or
# malformed-output errors do NOT switch providers. This key is for text/model
# fallback; subtitle speech-to-text uses Groq Whisper or local faster-whisper.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional final local LLM fallback. setup_teacher_worker.ps1 can check/install
# Ollama and pull only the configured model when -InstallOptionalTools is used.
# Existing Ollama/model installs are preserved and are never downloaded twice.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=240

# Local speech-to-text for AI subtitles and audio/video fallback. faster-whisper
# is installed from requirements-ai-worker.txt.
LOCAL_WHISPER_ENABLED=true
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

AI_QUESTION_WORKER_POLL_SECONDS=2
AI_QUESTION_WORKER_RECOVERY_SECONDS=300
AI_WORKER_HEARTBEAT_SECONDS=30
# AI Worker 偵測到程式資料夾被更新（教材 Worker 的安全更新器或手動 git pull）後，
# 會在閒置時自己重新啟動並載入新版；它不會自己執行 git。
AI_WORKER_RESTART_ON_UPDATE=true
MEDIA_SUBTITLE_JOB_STALE_MINUTES=30
MEDIA_SUBTITLE_JOB_MAX_ACTIVE_PER_USER=2
MEDIA_SUBTITLE_JOB_MAX_ACTIVE_TOTAL=8
AI_PRESENTATION_JOB_STALE_SECONDS=1800

# AI PowerPoint 0099/0100. Web and AI Worker MUST use the same shared provider.
# auto prefers R2 -> OCI -> Google Drive -> MEGA. Local is fail-closed unless
# explicitly enabled for a single-host development environment.
AI_PRESENTATION_STORAGE_BACKEND=auto
# Legacy deployments that still say "mega" transparently use configured R2.
AI_PRESENTATION_FALLBACK_TO_R2=true
AI_PRESENTATION_ALLOW_LOCAL_STORAGE=false
AI_PRESENTATION_MAX_TEMPLATE_MB=20
AI_PRESENTATION_MAX_ARTIFACT_MB=50

# AI video Phase 6. The Worker creates per-slide local Kokoro WAVs, timeline
# captions, then calls FFmpeg. Video bytes never go through the Web process.
# Frame renderer order is PowerPoint COM -> LibreOffice headless -> safe text.
# A working/activated PowerPoint is optional. If Office is expired or COM hangs,
# the bounded timeout moves on to LibreOffice automatically. Set COM false to
# skip it immediately on a host where PowerPoint is known to be unusable.
AI_VIDEO_STORAGE_BACKEND=auto
# Keep legacy AI_VIDEO_STORAGE_BACKEND=mega / inherited presentation=mega from
# blocking video authoring after the canonical shared provider moved to R2.
AI_VIDEO_FALLBACK_TO_R2=true
AI_VIDEO_ALLOW_LOCAL_STORAGE=false
AI_VIDEO_JOB_STALE_SECONDS=3600
AI_VIDEO_JOB_MAX_ACTIVE_PER_USER=1
AI_VIDEO_JOB_MAX_ACTIVE_TOTAL=3
AI_VIDEO_JOB_MAX_PER_MINUTE=1
AI_VIDEO_POWERPOINT_COM_ENABLED=true
AI_VIDEO_POWERPOINT_COM_TIMEOUT_SECONDS=45
# Optional explicit soffice.exe path. Leave blank to auto-detect PATH and the
# standard C:\Program Files\LibreOffice\program\soffice.exe location.
AI_VIDEO_LIBREOFFICE_PATH=
AI_VIDEO_LIBREOFFICE_TIMEOUT_SECONDS=120

# Free local AI narration. No OpenAI key is used. Kokoro runs on this Worker
# computer and outputs a WAV file that is published to the existing shared
# durable provider. setup_teacher_worker.ps1 validates the Python packages.
AI_TTS_PROVIDER=kokoro
KOKORO_MODEL=Kokoro-82M-v1.1-zh
KOKORO_REPO_ID=hexgrad/Kokoro-82M-v1.1-zh
KOKORO_VOICE=zf_001
KOKORO_TTS_SPEED=1.0
KOKORO_TTS_MAX_CHARS=12000
# Optional explicit persistent Hugging Face cache. If blank/unset, the AI
# Worker defaults to LOCALAPPDATA\Teacher\huggingface on Windows.
HF_HOME=
# auto (default): skip Hugging Face network checks once the model and default
# voice are cached. 1 = always offline, 0 = never. Set 0 (or run once online)
# when adding a new voice that is not cached yet.
KOKORO_HF_OFFLINE=auto
# Startup loads only KOKORO_VOICE; other voices load on first use.
KOKORO_PRELOAD_ALL_VOICES=false
# Kokoro warms in the background so non-TTS queues start immediately.
# true = wait for the warmup before polling any queue (old behaviour).
AI_WORKER_KOKORO_WARM_BLOCKING=false
KOKORO_TORCH_THREADS=2
KOKORO_CACHE_DIR=C:\TeacherWorker\.kokoro-tts
KOKORO_TTS_CACHE_DAYS=14

# Cloudflare R2 is required by Browser -> R2 material upload and by local AI
# narration output. It can also be selected for AI PowerPoint/video artifacts.
# Use the same bucket/account configuration as Render Web.
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_R2_BUCKET_NAME

# Primary MEGA storage example. Replace locally when MEGA is used.
MATERIAL_STORAGE_BACKEND=mega
MEGA_EMAIL=REPLACE_WITH_MEGA_EMAIL
MEGA_PASSWORD=REPLACE_WITH_MEGA_PASSWORD
MEGA_ROOT_FOLDER=smh-teaching-materials
# Worker 排程若用 SYSTEM 帳號執行，看不到其他使用者資料夾裡的 MEGAcmd。
# 在這裡填 MEGAcmd 所在資料夾（多個以分號分隔），例如 C:\Users\某人\AppData\Local\MEGAcmd
MEGACMD_EXTRA_DIRS=

# Optional Google Drive fallback. Leave blank unless configured on this host.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Exact-host allowlist for externally mounted direct MP4/WebM that the trusted
# AI Worker may download for local subtitle generation. Do not add YouTube/Vimeo.
EXTERNAL_MEDIA_HOSPITAL_CDN_HOSTS=
