# Copy this file to .local-worker.env on the trusted Worker host, then replace
# placeholders locally.  .local-worker.env is intentionally gitignored.

TEACHER_BASE_URL=https://teacher.example.invalid
MATERIAL_WORKER_TOKEN=REPLACE_WITH_RENDER_WORKER_TOKEN

# Local Worker reliability/runtime settings.
MATERIAL_WORKER_HEARTBEAT_SECONDS=30
MATERIAL_WORKER_AUTO_UPDATE=false
MATERIAL_WORKER_UPDATE_INTERVAL_HOURS=6
MATERIAL_WORKER_RELEASE_REF=v6.8.1
MATERIAL_WORKER_RELEASE_COMMIT=
MATERIAL_WORKER_REQUIRE_SIGNED_TAG=true

# Dedicated AI Worker. ai_question_worker.py owns AI question, media-script and
# local AI narration queues, so it must point at the same production database as Web.
# Keep the database URL and provider keys only on this trusted Worker host.
DATABASE_URL=REPLACE_WITH_PRODUCTION_DATABASE_URL
FREE_ONLY_MODE=true
AI_EXTERNAL_PROCESSING_ENABLED=true
AI_DEIDENTIFICATION_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.6-27b
AI_QUESTION_WORKER_POLL_SECONDS=2
AI_QUESTION_WORKER_RECOVERY_SECONDS=300

# Free local AI narration. No OpenAI key is used. Kokoro runs on this Worker
# computer and outputs a WAV file that is published to the existing R2 bucket.
AI_TTS_PROVIDER=kokoro
KOKORO_MODEL=Kokoro-82M-v1.1-zh
KOKORO_REPO_ID=hexgrad/Kokoro-82M-v1.1-zh
KOKORO_VOICE=zf_xiaoxiao
KOKORO_TTS_SPEED=1.0
KOKORO_TTS_MAX_CHARS=12000

# Cloudflare R2 is required by Browser -> R2 material upload and by local AI
# narration output. Use the same bucket/account configuration as Render Web.
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_R2_BUCKET_NAME

# Primary MEGA storage example. Replace locally when MEGA is used.
MATERIAL_STORAGE_BACKEND=mega
MEGA_EMAIL=REPLACE_WITH_MEGA_EMAIL
MEGA_PASSWORD=REPLACE_WITH_MEGA_PASSWORD
MEGA_ROOT_FOLDER=smh-teaching-materials

# Optional Google Drive fallback. Leave blank unless configured on this host.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
